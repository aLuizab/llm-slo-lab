---
extends: default
rules:
  line-length:
    max: 120
  document-start: enable
  comments:
    min-spaces-from-content: 1
  truthy:
    allowed-values: ["true", "false", "on", "off"]
    check-keys: false
ignore:
  - .venv/
  - "**/node_modules/"
  # generated by slo/gen_rules.py (PyYAML layout, long PromQL); validated by promtool instead
  - slo/rules.yaml
  - slo/rules-demo.yaml
  - slo/prometheus/
  # generated by dashboards/gen_dashboard.py (Grafana JSON inside a ConfigMap)
  - dashboards/llm-slos-configmap.yaml
