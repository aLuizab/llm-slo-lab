# Pinned versions for the lab. Sourced by the Makefile and scripts.
# Checked against upstream releases on 2026-10-07. See docs/decisions.md.

# Local toolchain
KIND_VERSION=v0.33.0
KIND_NODE_IMAGE=kindest/node:v1.36.4
KUBECTL_VERSION=v1.36.5
HELM_VERSION=v4.3.0
PROMETHEUS_VERSION=3.15.0          # promtool comes from this release
KUBECONFORM_VERSION=v0.8.0
YAMLLINT_VERSION=1.38.0
UV_VERSION=0.12.23
RUFF_VERSION=0.16.10
PYTHON_VERSION=3.12

# Platform (Helm charts)
CERT_MANAGER_VERSION=v1.21.2
KSERVE_VERSION=v0.20.0             # v0.21.0 has no chart tag on ghcr yet (ADR-003)
KEDA_VERSION=2.21.0
KUBE_PROMETHEUS_STACK_VERSION=92.1.0
OTEL_COLLECTOR_CHART_VERSION=0.175.1
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.162.0
JAEGER_CHART_VERSION=4.14.1
JAEGER_IMAGE=jaegertracing/jaeger:2.22.0

# Model serving
KSERVE_HF_IMAGE=kserve/huggingfaceserver:v0.20.0
MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
MODEL_REVISION=7ae557604adf67be50417f59c2c2f167def9a775   # HF commit, for the tokenizer in the gateway image

# Python libraries (pinned again in each service's pyproject.toml)
OTEL_PYTHON_VERSION=1.45.1
OTEL_SEMCONV_PYTHON_VERSION=0.66b1
HF_HUB_VERSION=2.1.1               # model download job only
